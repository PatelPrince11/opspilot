# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=            # optional, only if student credits are approved
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACING_ENABLED=false         # opt-in: set to true once Langfuse keys are filled in
TRACING_SAMPLE_RATE=1.0       # lower for bulk eval runs to save Langfuse units
# Postgres container credentials; must match DATABASE_URL.
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opspilot
# Host ports (127.0.0.1 only). Container ports stay 5432/8000.
DB_HOST_PORT=5433
APP_HOST_PORT=8001
# `db` is the compose service name. Host-side tools use localhost:${DB_HOST_PORT} instead.
DATABASE_URL=postgresql://opspilot:change-me@db:5432/opspilot
OLLAMA_HOST=http://host.docker.internal:11434
API_KEY=                      # protects /investigate (Phase 5)
# LLMs as provider:model (llm/client.py). Set AGENT_LLM=ollama:qwen2.5:7b to develop offline.
AGENT_LLM=groq:openai/gpt-oss-120b
JUDGE_LLM=gemini:gemini-3.5-flash-lite
DEV_LLM=ollama:qwen2.5:7b
LLM_TOKEN_BUDGET=6000         # per call: estimated prompt + max output tokens
VERIFY_ENABLED=true           # citation verify loop; false for the with/without comparison
READONLY_DB_PASSWORD=readonly-change-me   # role opspilot_ro, used by the agent's tools
