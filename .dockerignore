# Secrets are injected at runtime by Compose (env_file), never baked into the image.
.env
.git
.venv
.claude
**/__pycache__
.pytest_cache
.ruff_cache
.DS_Store
data/raw/
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
# Local caches and scratch: never in the image (the LLM cache is per deployment, on a volume).
.cache
scratchpad
.env.*
!.env*.example
