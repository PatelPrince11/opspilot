# Server .env for docker-compose.prod.yml (docs/deploy.md). Copy to .env ON THE SERVER and fill
# in there. Placeholders only: never commit the filled file, never bake it into an image.
# Generate random values with: openssl rand -hex 32

# --- LLM providers ---
OPENROUTER_API_KEY=replace-me           # the agent: gpt-oss-120b via OpenRouter, pinned to Groq
GROQ_API_KEY=replace-me                 # Prompt Guard (the shipped defenses call it)
GEMINI_API_KEY=                         # judge only; not used by the API, may stay empty
AGENT_LLM=openrouter:openai/gpt-oss-120b
OPENROUTER_PROVIDER=groq

# --- /investigate guard ---
API_KEYS=replace-me                     # comma-separated; empty refuses every request
RATE_PER_MINUTE=5                       # per key and per client IP
RATE_PER_DAY=100
DAILY_SPEND_LIMIT_USD=1.0               # 503 once today's (UTC) LLM spend reaches this

# --- LLM response cache (on the `cache` volume); set empty to disable ---
LLM_CACHE_DIR=/app/.cache/llm

# --- Postgres (container only, never published); DATABASE_URL must match ---
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=opspilot
DATABASE_URL=postgresql://opspilot:replace-me@db:5432/opspilot
READONLY_DB_PASSWORD=replace-me         # role opspilot_ro, used by the agent's tools

# --- Tracing (optional) ---
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
